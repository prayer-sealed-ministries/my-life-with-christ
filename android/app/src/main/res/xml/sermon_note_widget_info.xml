<?xml version="1.0" encoding="utf-8"?>
<!--
  The widget's declaration.

  `updatePeriodMillis="0"` is the load-bearing line. This widget shows one
  fixed action and has nothing to refresh, so it asks the system to wake
  nothing, ever: no alarm, no polling, no journal read to redraw a word that
  never changes. A widget that woke the app on a timer would cost a person
  battery for no information at all.

  Two cells by one — the smallest footprint that still reads as a sentence
  rather than an icon. `targetCellWidth`/`targetCellHeight` are honoured from
  API 31 and ignored below it, where `minWidth`/`minHeight` say the same thing
  in the older units.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/widget_sermon_note"
    android:previewLayout="@layout/widget_sermon_note"
    android:resizeMode="horizontal"
    android:widgetCategory="home_screen"
    android:description="@string/widget_sermon_note_description" />
