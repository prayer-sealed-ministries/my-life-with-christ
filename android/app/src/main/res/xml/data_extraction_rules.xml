<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12 and above.

  The same exclusion as backup_rules.xml, for both of the paths this version of
  Android distinguishes: cloud backup, and a direct device-to-device transfer.
  The reasoning is identical — see backup_rules.xml — and it applies to a phone
  handed over in a shop just as much as to a restore from the cloud.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="app_lock.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="app_lock.xml" />
    </device-transfer>
</data-extraction-rules>
