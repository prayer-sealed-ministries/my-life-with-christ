<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Scan notes: the camera, and only when asked.

      Requested at the moment someone taps Take photo, never at launch and never
      during onboarding. Denying it costs only that one button; choosing an
      existing photo still works, and the rest of the app is untouched.

      `required="false"` so the app still installs on a device without a camera.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <!--
      ML Kit arrives with permissions this app does not want and does not need.

      Adding com.google.mlkit:text-recognition pulls in play-services-base and
      play-services-basement, which merge INTERNET, ACCESS_NETWORK_STATE,
      BIND_JOB_SERVICE and DUMP into an application that previously declared
      none at all. Text recognition itself is entirely local — the bundled Latin
      model was proven to recognise all 26 benchmark pages with airplane mode on
      and every radio disabled — so the permissions are removed rather than
      inherited.

      This is not cosmetic. A journal that promises nothing leaves the device
      should not ship holding the permission that would let it.

      If recognition ever stops working after a dependency upgrade, the honest
      response is to investigate what started needing the network, not to quietly
      restore these lines.
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
    <uses-permission android:name="android.permission.BIND_JOB_SERVICE" tools:node="remove" />
    <uses-permission android:name="android.permission.DUMP" tools:node="remove" />


    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              The launcher shortcut's destination.

              Narrow on purpose: one scheme this application owns, and the only
              thing it can carry is an action name that must appear in the
              allow-list in src/app/launch-actions.ts. Anything else — another
              scheme, an unknown action, a route smuggled into the path — is a
              normal launch. No new permission, and nothing here reaches the
              network.
            -->
            <intent-filter android:label="@string/shortcut_sermon_note_long">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="@string/launch_action_scheme" android:host="action" />
            </intent-filter>

            <!--
              Receiving a sermon handout from Mail, Files, Messages or a church
              app: "Share with" and "Open in".

              The media types are exactly the four the sermon-note importer can
              read (src/import/incoming.ts, asserted against this file by
              src/platform/android-share.test.ts). DOCX is absent because the
              sermon importer does not read it — that is the document importer,
              a different feature. Registering for a type this app cannot open
              would put it in the share sheet and break the promise the moment
              somebody took it up.

              No storage permission is involved. A share grants read access to
              one document for the life of this activity, which is all the
              plugin needs and all it takes.
            -->
            <intent-filter android:label="@string/share_sermon_notes_label">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
                <data android:mimeType="text/markdown" />
                <data android:mimeType="application/json" />
                <data android:mimeType="application/pdf" />
            </intent-filter>

            <!-- "Open in", from a file manager or a mail attachment. -->
            <intent-filter android:label="@string/share_sermon_notes_label">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="content" android:mimeType="text/plain" />
                <data android:scheme="content" android:mimeType="text/markdown" />
                <data android:scheme="content" android:mimeType="application/json" />
                <data android:scheme="content" android:mimeType="application/pdf" />
            </intent-filter>

            <!-- Long-press the app icon. See res/xml/shortcuts.xml. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />

        </activity>

        <!--
          The home-screen widget: one tap into a new sermon note.

          `exported="false"` on purpose. A widget receiver only ever hears from
          the system, which addresses it explicitly by component, so there is
          no reason to offer this receiver to every application on the device.
          The intent the widget SENDS is explicit too (see
          SermonNoteWidget.java), and carries an action name rather than a
          route — the same one the launcher shortcut carries.

          No periodic update is declared: see res/xml/sermon_note_widget_info.xml.
        -->
        <receiver
            android:name=".SermonNoteWidget"
            android:label="@string/widget_sermon_note_label"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/sermon_note_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <!-- EXPERIMENT: INTERNET removed to test whether the packaged app needs it. -->
</manifest>
