# Native signing material. Nothing here is ever committed, on any branch.
# Keystores and provisioning profiles are credentials: a leaked upload key
# cannot be rotated for an existing Play listing without Google's help.
*.jks
*.keystore
*.mobileprovision
*.provisionprofile
*.p12
*.cer
*.certSigningRequest
keystore.properties
key.properties
android/key.properties
google-services.json
GoogleService-Info.plist

# Native build output and machine-specific state.
ios/App/build/
ios/DerivedData/
**/xcuserdata/
android/.gradle/
android/local.properties

# ---------------------------------------------------------------------------
# Licensed source material. NEVER COMMITTED, on any branch.
#
# Licensed third-party source documents and everything generated from them are
# not part of this repository — see DATA-LICENSE.md. A copy may sit in a
# working tree because its licensee owns one; these rules are what stop it
# being staged by a wide `git add`.
#
# Deliberately NOT a blanket `*.pdf` or `data/source/**`: the Berean Standard
# Bible files under data/source/bsb_usfm/ are public domain and ARE committed,
# and a public PDF should stay addable. The patterns below name the licensed
# material and its derivatives, and nothing else.
# ---------------------------------------------------------------------------
data/source/Purchased_*
data/source/*.pdf
src/data/outlines.json
src/data/title-overrides.json
src/data/reference-overrides.json
data/ingest-report.md
data/coverage-report.md
data/coverage-comparison.md
scripts/probe-baseline.json

# The ingest and parsers that read the licensed source documents, and their
# fixtures. Removed from the tree; named here so a stray copy cannot return by
# way of a wide `git add`.
scripts/ingest-outlines.mjs
scripts/compare-coverage.mjs
scripts/build-coverage-report.mjs
scripts/lib/parse-outlines.mjs
scripts/lib/extract-pdf.mjs
scripts/lib/title-wording.mjs
scripts/lib/probes.mjs
scripts/lib/__tests__/parse-outlines.test.mjs
scripts/lib/__tests__/title-wording.test.mjs

# Anywhere a person might reasonably stage private inputs.
private/
data/private/
*.private.json
