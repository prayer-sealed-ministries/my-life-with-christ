#!/usr/bin/env bash
#
# The first line of defence, and — given who holds the bypass — the real one.
#
# Branch protection on main runs with `enforce_admins: false`, which means the
# repository owner can push straight past the required status check. So can
# anything pushing WITH the owner's token, which includes every coding agent
# that touches this repo. That is precisely the party most likely to make the
# mistake the gate exists to catch.
#
# This hook does not care who or what is pushing. It runs locally, before a bad
# commit reaches history at all.
#
# What it checks:
#   1. The workflow policy tests — that pages.yml still pins refs-only, verifies
#      before uploading, and cannot deploy without a passing build.
#   2. The bundle gate — that a refs-only build carries none of the purchased
#      compilation, and that the probe set has not eroded.
#
# It can be skipped with `git push --no-verify`. Git does not run the hook at
# all in that case, so nothing here can warn you: the backstop is the `data-gate`
# job in CI, which runs on every push to main regardless.

set -uo pipefail

BOLD=$(tput bold 2>/dev/null || true)
RESET=$(tput sgr0 2>/dev/null || true)

if [ "${SKIP_DATA_GATE:-}" = "1" ]; then
  echo ""
  echo "${BOLD}!! DATA GATE SKIPPED — SKIP_DATA_GATE=1 !!${RESET}"
  echo "!! Nothing has checked this push for purchased outline content."
  echo "!! See DATA-LICENSE.md. CI will still run data-gate on main."
  echo ""
  exit 0
fi

echo "${BOLD}pre-push: checking the data gate${RESET}"

fail() {
  echo ""
  echo "${BOLD}PUSH REFUSED — $1${RESET}"
  echo ""
  echo "This protects against publishing purchased outline content. See DATA-LICENSE.md."
  echo "If you are certain this is wrong, 'git push --no-verify' bypasses it —"
  echo "but CI will still fail on main, and the Pages deploy will refuse to publish."
  echo ""
  exit 1
}

echo "  1/2  workflow policy + probe-set integrity"
if ! npx vitest run scripts/__tests__/ --silent >/tmp/journey-gate-policy.log 2>&1; then
  tail -40 /tmp/journey-gate-policy.log
  fail "the workflow policy or probe-set tests failed"
fi

echo "  2/2  refs-only build carries none of the compilation"
if ! DATA_PROFILE=refs-only npx vite build >/tmp/journey-gate-build.log 2>&1; then
  tail -40 /tmp/journey-gate-build.log
  fail "the refs-only build did not complete"
fi

if ! node scripts/verify-bundle.mjs --profile refs-only >/tmp/journey-gate-verify.log 2>&1; then
  cat /tmp/journey-gate-verify.log
  fail "the built artefact contains purchased content, or the gate has eroded"
fi

echo "${BOLD}pre-push: gate passed${RESET}"
exit 0
