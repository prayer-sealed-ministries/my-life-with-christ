{
  "name": "journey",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:public": "DATA_PROFILE=public npm run build",
    "build:refs-only": "DATA_PROFILE=refs-only npm run build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test a11y.spec.ts keyboard.spec.ts contrast.spec.ts reflow.spec.ts",
    "test:e2e:sweep": "scripts/e2e-sweep.sh",
    "test:profiles": "node scripts/profile-coverage.mjs",
    "screenshots": "playwright test screenshots.spec.ts && node scripts/screenshot-index.mjs",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "verify:deployed": "node scripts/verify-deployed.mjs",
    "verify:no-private-data": "node scripts/verify-no-private-data.mjs",
    "gate": "npm run verify:no-private-data && npx vitest run scripts/__tests__/ && DATA_PROFILE=refs-only npm run build && npm run verify:bundle -- --profile refs-only",
    "ingest:sections": "node scripts/ingest-sections.mjs",
    "fetch:kjv": "node scripts/fetch-kjv.mjs",
    "native:assets": "node scripts/native-assets.mjs",
    "native:sync": "node scripts/native-sync.mjs",
    "native:ios": "npm run native:sync && npx cap open ios",
    "native:android": "npm run native:sync && npx cap open android",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.1.1",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "dexie": "^4.4.6",
    "fflate": "^0.8.3",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0",
    "yaml": "^2.9.1"
  }
}
